 application "Solar Panel Performance & Maintenance Tracker"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "UTC"
 	time format = "24-hr"

 	forms
	{
		form Energy_Readigs
		{
			displayname = "Energy Readigs"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Panel
			(
				type = picklist	
				values  = Solar_Panels.ID
    			displayformat = [Panel_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Reading_Date
			(
    			type = date
				displayname = "Reading Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Expected_Energy
			(
				type = decimal
				displayname = "Expected Energy"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Actual_Energy
			(
				type = decimal
				displayname = "Actual Energy"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Performance
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Healthy","Needs Attention","Inspection Required","Critical"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			AI_Maintenance_Recommendations
			(
    			type = textarea
				displayname = "AI Maintenance Recommendations"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Maintenance_Records
		{
			displayname = "Maintenance Records"
			success message = "Maintenance Record Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Maintenance_ID
			(
    			type = text
				displayname = "Maintenance ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Panel_ID
			(
				type = picklist	
				displayname = "Panel ID"
				values  = Solar_Panels.ID
    			displayformat = [Panel_ID]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Problem
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Maintenance_Date
			(
    			type = date
				displayname = "Maintenance Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Technician
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cost
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Action_Taken
			(
    			type = textarea
				displayname = "Action Taken"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","In Progress","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Next_Maintenance_Date
			(
    			type = date
				displayname = "Next Maintenance Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Keyword
			(
    			type = textarea
				displayname = "AI Maintenance Keywords"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = KeywordExtractor
									basefield = Problem
						)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Self_Service_Form
		{
			displayname = "Self Service Form"
			success message = "Self Service Added Successfully"
			What_do_you_want_to_do1
			(
				type = section
				displayname = "What do you want to do?"
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain1
			(
    			type = plaintext
				value = "<p style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\" class=\"zw-paragraph heading0\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">💡 </span><span class=\"size\" style=\"font-size: 12pt; font-weight: 600; vertical-align: baseline\">Creator tip:</span><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\"> Use this sample form to capture data. Below is an example of how it may look.</span></span></span><br /></p><p style=\"margin: 0px 0px 0pt; line-height: 1.2; text-align: left; direction: ltr\" class=\"zw-paragraph heading0\"><br /></p><div><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">Feel free to tweak things via the </span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">form builder. Every form submission is recorded in a </span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">r</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">eport and can be visuali</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">z</span></span></span><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400\">ed.</span></span></span><br /></div><div><br /></div><div><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\">N</span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; vertical-align: baseline; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; letter-spacing: 0pt\">ote: </span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\">If you're capturing sensitive data via a field,</span></span></span></span><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\"> take a look at its properties to make it secured.</span></span></span></span><br /></div><div><span class=\"highlight\" style=\"background-color: rgba(0, 0, 0, 0)\"><span class=\"colour\" style=\"color: rgb(0, 0, 0)\"><span class=\"font\" style=\"font-family: Lato\"><span class=\"size\" style=\"font-size: 12pt; font-variant: normal; text-decoration: none; letter-spacing: 0pt; font-weight: 400; vertical-align: baseline; font-style: normal\"></span></span></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			What_do_you_want_to_track
			(
				type = picklist
				displayname = "What do you want to track?"
				maxchar = 100
				values = {"Tasks","Bugs","Projects","Expenses","Assets","Something else"}
	 			row = 1
	 			column = 1   
				width = large
			)
			Add_Tasks
			(
				type = section
				displayname = "Add Tasks"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Task_name
			(
    			type = text
				displayname = "Task name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Due_Date
			(
    			type = date
				displayname = "Due Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 2
	 			column = 1   
				width = medium
			)
			Priority
			(
				type = picklist
				maxchar = 100
				values = {"High","Medium","Low"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				displayname = " Status"
				maxchar = 100
				values = {"Yet to Start","In-Progress","In Review","Completed"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = text
	 			row = 2
	 			column = 1   
				width = medium
			)
			Add_a_New_Bug
			(
				type = section
				displayname = "Add a New Bug"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Auto_Number
			(
    			type = autonumber
				displayname = "Auto Number"
				start index = 101
	 			row = 3
	 			column = 1   
				width = medium
			)
			Bug_Title
			(
    			type = text
				displayname = "Bug Title"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Date_Reported
			(
    			type = date
				displayname = "Date Reported"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Severity
			(
				type = picklist
				maxchar = 100
				values = {"Low","Medium","Critical"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Status1
			(
				type = picklist
				displayname = "Status"
				maxchar = 100
				values = {"Open","Escalated","Closed"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Description1
			(
    			type = text
				displayname = "Description"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Track_Projects
			(
				type = section
				displayname = "Track Projects"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Project_Name
			(
    			type = text
				displayname = "Project Name"
	 			row = 4
	 			column = 1   
				width = medium
			)
			Project_Manager
			(
    			type = picklist
				displayname = "Project Manager"
				module = users
				displayformat = [username]
	 			row = 4
	 			column = 1   
				width = medium
				personal data = true
			)
			Start_Date
			(
    			type = date
				displayname = "Start Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			End_Date
			(
    			type = date
				displayname = "End Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
			Status2
			(
				type = picklist
				displayname = "Status"
				maxchar = 100
				values = {"Not Started","On-Track","Delayed","Live"}
				others option = true
	 			row = 4
	 			column = 1   
				width = medium
			)
			Summary
			(
    			type = text
	 			row = 4
	 			column = 1   
				width = medium
			)
			Expense_Claim
			(
				type = section
				displayname = "Expense Claim"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Expense_Date
			(
    			type = date
				displayname = "Expense Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Amount
			(
				type = USD
				format = commadotwestern
	 			row = 5
	 			column = 1   
				width = medium
			)
			Expense_Type
			(
				type = picklist
				displayname = "Expense Type"
				maxchar = 100
				values = {"Travel - Client Meeting","Meals","Accommodation","Software Subscription"}
				others option = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Notes
			(
    			type = text
	 			row = 5
	 			column = 1   
				width = medium
			)
			Track_Assets
			(
				type = section
				displayname = "Track Assets"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Asset_Type
			(
				type = picklist
				displayname = "Asset Type"
				maxchar = 100
				values = {"Laptop","Monitor","Mouse","Headphones","Mobile"}
				others option = true
	 			row = 6
	 			column = 1   
				width = medium
			)
			Purchase_Date
			(
    			type = date
				displayname = "Purchase Date"
				initial value = "${zoho.currentdate}"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 6
	 			column = 1   
				width = medium
			)
			Usecase
			(
    			type = text
	 			row = 6
	 			column = 1   
				width = medium
			)
			Something_Else
			(
				type = section
				displayname = "Something Else"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div>\n <span style=\"font-family: Lato, sans-serif\" class=\"font\"><span style=\"font-size: 16px\" class=\"size\">Want to tailor this form to your specific needs? If this form doesn't cover your requirement, simply navigate to 'Edit this Application' at the top right to enter Edit Mode. </span></span>\n <br>\n</div>\n<div>\n <br>\n</div>\n<div>\n <span style=\"font-family: Lato, sans-serif\" class=\"font\"><span style=\"font-size: 16px\" class=\"size\">Here, you can open the form and add your unique fields.</span></span>\n <br>\n</div>\n<div>\n <br>\n</div>\n<div>\n <span style=\"font-family: Lato, sans-serif\" class=\"font\"><span style=\"font-size: 16px\" class=\"size\">For guidance on adding and customizing fields, <a style=\"color: rgb(0, 0, 238)\" rel=\"noopener noreferrer\" target=\"_blank\" href=\"https://help.zoho.com/portal/en/kb/creator/developer-guide/forms/add-and-manage-fields/articles/understand-fields\">click here to access</a> our quick guide.</span></span>\n <br>\n</div>"
	 			row = 7
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Solar_Panels
		{
			displayname = "Solar Panels"
			success message = "Solar Panel Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Panel_ID
			(
    			type = text
				displayname = "Panel ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Panel_Name
			(
    			type = text
				displayname = "Panel Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Location
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Panel_T
			(
				type = picklist
				displayname = "Panel Type"
				maxchar = 100
				values = {"Monocrystalline","Polycrystalline","Thin Film"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Capacity
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Installation_Date
			(
    			type = date
				displayname = "Installation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Under Maintenance","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Solar_Panels
		{
			displayName = "All Solar Panels"
			show all rows from Solar_Panels    
			(
				Panel_ID as "Panel ID"
				Panel_Name as "Panel Name"
				Location
				Panel_T as "Panel Type"
				Capacity
				Installation_Date as "Installation Date"
				Status
			)
		}
		default list Energy_Readigs_Report
		{
			displayName = "Energy Readigs Report"
			show all rows from Energy_Readigs    
			(
				Panel
				Reading_Date as "Reading Date"
				Expected_Energy as "Expected Energy"
				Actual_Energy as "Actual Energy"
				Performance
				Status
				AI_Maintenance_Recommendations as "AI Maintenance Recommendations"
			)
		}
		default list All_Maintenance_Records
		{
			displayName = "All Maintenance Records"
			show all rows from Maintenance_Records    
			(
				Maintenance_ID as "Maintenance ID"
				Panel_ID as "Panel ID"
				Problem
				Maintenance_Date as "Maintenance Date"
				Technician
				Cost
				Action_Taken as "Action Taken"
				Status
				Next_Maintenance_Date as "Next Maintenance Date"
				Keyword as "AI Maintenance Keywords"
			)
		}
		list All_Bugs
		{
			displayName = "All Bugs"
			show all rows from Self_Service_Form  [What_do_you_want_to_track == "Bugs"]  
			(
				What_do_you_want_to_track as "What do you want to track?"
				Task_name as "Task name"
				Due_Date as "Due Date"
				Priority
				Status as " Status"
				Description
				Auto_Number as "Auto Number"
				Bug_Title as "Bug Title"
				Date_Reported as "Date Reported"
				Severity
				Status1 as "Status"
				Description1 as "Description"
				Project_Name as "Project Name"
				Project_Manager as "Project Manager"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Status2 as "Status"
				Summary
				Expense_Date as "Expense Date"
				Amount
				Expense_Type as "Expense Type"
				Notes
				Asset_Type as "Asset Type"
				Purchase_Date as "Purchase Date"
				Usecase
			)
		}
		default list All_Trackings
		{
			displayName = "All Tasks"
			show all rows from Self_Service_Form  [What_do_you_want_to_track == "Tasks"]  
			(
				Task_name as "Task name"
				Priority
				Status as " Status"
				Auto_Number as "Auto Number"
				Status1 as "Status"
				Severity
				Project_Manager as "Project Manager"
				End_Date as "End Date"
				Status2 as "Status"
				Summary
				Notes
				Asset_Type as "Asset Type"
				Purchase_Date as "Purchase Date"
				Usecase
				Due_Date as "Due Date"
				Description
			)
		}
	}
	pages
	{
		page Tracker_Dashbaord
		{
			displayname = "Tracker Dashbaord"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\twebDeviceConfig='{\"layout\":{\"displayType\":\"card\",\"design\":\"fluid\",\"style\":\"padding-right:0px;padding-top:px;padding-bottom:0px;padding-left:0px;\"}}'\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='70%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Column'\n\txtitle = 'Panel ID'\n\tytitle = 'Performance %'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Energy_Readigs'\n\txfield = 'Panel.Panel_ID'\n\tyfields = 'value:Performance'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\ttype = 'Column'\n\txtitle = 'Panel ID'\n\tytitle = 'Energy(kWh)'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Energy_Readigs'\n\txfield = 'Panel.Panel_ID'\n\tyfields = 'value:Actual_Energy,value:Expected_Energy'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\ttype = 'Donut'\n\txtitle = 'Performance'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Maintenance_Records'\n\txfield = 'Status'\n\tyfields = 'count:Maintenance_ID'\n/>\n\n</column>\n</row>\n</column><column\n   \t\t width='30%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Solar_Panels.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Solar Panels'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;Healthy&quot;'\n\t  value = 'thisapp.Energy_Readigs.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Healthy Panels'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;Critical&quot;'\n\t  value = 'thisapp.Energy_Readigs.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Critical'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;Inspection Required&quot;'\n\t  value = 'thisapp.Energy_Readigs.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Inspection Required'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '36px'\n\tbold = 'true' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Status == &quot;Needs Attention&quot;'\n\t  value = 'thisapp.Energy_Readigs.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Needs Attention'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</column>\n</row>\n</layout>\n</zml>"
