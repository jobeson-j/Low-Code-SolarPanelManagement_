		workflow
		{
		form
		{
			Calculate_Performance as "Calculate Performance"
			{
				type =  form
				form = Energy_Readigs

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Expected_Energy > 0)
										{
											input.Performance = input.Actual_Energy / input.Expected_Energy * 100;
											if(input.Performance > 85)
											{
												input.Status = "Healthy";
											}
											else if(input.Performance >= 70)
											{
												input.Status = "Needs Attention";
											}
											else if(input.Performance >= 50)
											{
												input.Status = "Inspection Required";
											}
											else
											{
												input.Status = "Critical";
											}
											ai_response = zia
											[
												message:"You are a solar panel maintenance assistant. Analyze this energy reading and give ONE short, practical maintenance recommendation. Panel: " + input.Panel + ", Expected Energy: " + input.Expected_Energy + ", Actual Energy: " + input.Actual_Energy + ", Performance: " + input.Performance + "%, Status: " + input.Status
											];
											if(ai_response.status == true)
											{
												input.AI_Maintenance_Recommendations = ai_response.data;
											}
										}
						)
					}
				}

			}
			Low_Performance_Alert as "Low Performance Alert"
			{
				type =  form
				form = Energy_Readigs

				record event = on add or edit

				on success
				{
					actions  (Performance < 70)
					{
					pushnotification
					(
						sender type : "users"
						to : "juliusjobeson@gmail.com"
						title : "⚠️ Low Solar Panel Performance"
						message : "A solar panel has performance below 70%. Please inspect the panel and check its energy generation."
						view: "Energy_Readigs_Report"
					)
					}
				}

			}
			Maintenance_Reminder as "Maintenance Reminder"
			{
				type =  form
				form = Maintenance_Records

				record event = on add or edit

				on success
				{
					actions  (Maintenance_Date == today)
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "jobeson.j.2024.cse@rajalakshmi.edu.in"
							subject : " Solar Panel Maintenance Due"
							message : "<div><code>A solar panel maintenance date is due today. Please inspect the panel and complete the scheduled maintenance.</code> <br></div>"
						)
					}
				}

			}
			show_hide_fields as "show/hide fields"
			{
				type =  form
				form = Self_Service_Form

				record event = on add or edit

				field rules
				{
					actions  (What_do_you_want_to_track == "Tasks")
					{
						hide Add_a_New_Bug,Track_Projects,Track_Assets,Expense_Claim,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Bugs")
					{
						hide Add_Tasks,Track_Projects,Track_Assets,Expense_Claim,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Projects")
					{
						hide Add_Tasks,Add_a_New_Bug,Track_Assets,Expense_Claim,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Assets")
					{
						hide Add_Tasks,Add_a_New_Bug,Expense_Claim,Track_Projects,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Expenses")
					{
						hide Add_Tasks,Add_a_New_Bug,Track_Assets,Track_Projects,Something_Else;
					}
					actions  (What_do_you_want_to_track is null)
					{
						hide Expense_Claim,Add_Tasks,Add_a_New_Bug,Track_Assets,Track_Projects,Something_Else;
					}
					actions  (What_do_you_want_to_track == "Something else")
					{
						hide Expense_Claim,Add_Tasks,Add_a_New_Bug,Track_Assets,Track_Projects;
					}
				}

			}
		}






	}
